local Whitelisted = {}
local SelectedTarget = ""
local KillRadius = 75
local SpectateConn = nil
local SpectateTarget = nil

local function GetCharacter()
  local char = LocalPlayer.Character
  if not char then
    char = LocalPlayer.CharacterAdded:Wait()
  end
  return char
end

local function EquipAndPunch()
  local char = LocalPlayer.Character
  if not char then
    return
  end
  local humanoid = char:FindFirstChildOfClass("Humanoid")
  if not humanoid or humanoid.Health <= 0 then
    return
  end
  local punch = LocalPlayer.Backpack:FindFirstChild("Punch") or char:FindFirstChild("Punch")
  if punch then
    if punch.Parent ~= char then
      punch.Parent = char
    end
    local attackTime = punch:FindFirstChild("attackTime")
    if attackTime then
      attackTime.Value = 0
    end
  end
  local muscleEvent = LocalPlayer:FindFirstChild("muscleEvent") or char:FindFirstChild("muscleEvent")
  if muscleEvent then
    muscleEvent:FireServer("punch", "leftHand")
    muscleEvent:FireServer("punch", "rightHand")
  end
  if punch and punch.Parent == char then
    punch:Activate()
  end
end

local function TouchKill(targetPlayer)
  local char = GetCharacter()
  local tChar = targetPlayer.Character
  local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
  local leftHand = char and char:FindFirstChild("LeftHand")
  if tRoot and leftHand then
    firetouchinterest(tRoot, leftHand, 0)
    firetouchinterest(tRoot, leftHand, 1)
    EquipAndPunch()
  end
end

local function GetWhitelistList()
  local list = {}
  for name in pairs(Whitelisted) do
    local plr = Players:FindFirstChild(name)
    if plr then
      table.insert(list, plr.Name .. " | " .. plr.DisplayName)
    else
      table.insert(list, name)
    end
  end
  return list
end

local WhitelistedDropdown

local function RefreshWhitelistDropdown()
  if WhitelistedDropdown then
    WhitelistedDropdown:Set(GetWhitelistList(), false)
  end
end

Players.PlayerAdded:Connect(function(plr)
  local lowerName = plr.Name:lower()
  local lowerDisplay = plr.DisplayName:lower()
  for name in pairs(Whitelisted) do
    if lowerName == name:lower() or lowerDisplay == name:lower() then
      Whitelisted[plr.Name] = true
      RefreshWhitelistDropdown()
    end
  end
  if getgenv().autoWhitelistFriends and plr:IsFriendsWith(LocalPlayer.UserId) then
    Whitelisted[plr.Name] = true
    RefreshWhitelistDropdown()
  end
end)

WhitelistSection:AddTextBox({
  Title = "Whitelist",
  PlaceholderText = "Type username or display name...",
  Default = "",
  Flag = "WhitelistInput",
  Callback = function(val)
    if val ~= "" then
      local q = val:lower()
      for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name:lower() == q or (plr.DisplayName and plr.DisplayName:lower() == q) then
          Whitelisted[plr.Name] = true
        end
