    if state then
      task.spawn(function()
        while getgenv().killTarget do
          if SelectedTarget ~= "" then
            for _, plr in ipairs(Players:GetPlayers()) do
              local q = SelectedTarget:lower()
              local match = plr.Name:lower() == q or (plr.DisplayName and plr.DisplayName:lower() == q)
              if match and plr ~= LocalPlayer then
                local hum = plr.Character and plr.Character:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 then
                  TouchKill(plr)
                end
              end
            end
          end
          RunService.Heartbeat:Wait()
        end
      end)
    else
      local char = LocalPlayer.Character
      local hum = char and char:FindFirstChild("Humanoid")
      if hum then
        hum:UnequipTools()
      end
    end
  end
})

KillingSection:AddTextBox({
  Title = "Kill Aura Radius [75-350]",
  PlaceholderText = "Enter radius...",
  Default = "75",
  Flag = "RadiusInput",
  Callback = function(val)
    KillRadius = math.clamp(tonumber(val) or 75, 1, 350)
  end
})

local function CreateAuraEffect(root)
  local att = Instance.new("Attachment", root)
  local pe = Instance.new("ParticleEmitter", att)
  pe.Texture = "rbxassetid://244905904"
  pe.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 255, 0)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 155, 0))
  })
  pe.Size = NumberSequence.new({
    NumberSequenceKeypoint.new(0, 0.5),
    NumberSequenceKeypoint.new(1, 0)
  })
  pe.Lifetime = NumberRange.new(0.5, 1)
  pe.Rate = 50
  pe.Speed = NumberRange.new(5, 10)
  pe.SpreadAngle = Vector2.new(-180, 180)
  local beam = Instance.new("Beam", root)
  beam.Texture = "rbxassetid://446111271"
  beam.TextureSpeed = 3
  beam.Color = ColorSequence.new(Color3.fromRGB(0, 255, 0))
  return {pe, beam}
end

KillingSection:AddToggle({
  Title = "Kill Aura",
  Default = false,
  Flag = "Kill_Nearby",
  Callback = function(state)
    getgenv().killNearby = state
    if not state then
      return
    end
    local ring = Instance.new("Part")
    ring.Anchored = true
    ring.CanCollide = false
    ring.Transparency = 0.8
    ring.Material = Enum.Material.ForceField
    ring.Color = Color3.fromRGB(0, 255, 0)
    ring.Size = Vector3.new(1, 0.1, 1)
    task.spawn(function()
      while getgenv().killNearby do
        pcall(function()
          local char = LocalPlayer.Character
          local root = char and char:FindFirstChild("HumanoidRootPart")
          local leftHand = char and char:FindFirstChild("LeftHand")
          if root and leftHand then
            ring.Parent = workspace
            ring.Size = Vector3.new(KillRadius * 2, 0.1, KillRadius * 2)
            ring.CFrame = root.CFrame * CFrame.new(0, -2, 0)
            local fx = CreateAuraEffect(root)
            for _, plr in ipairs(Players:GetPlayers()) do
              if plr ~= LocalPlayer and not Whitelisted[plr.Name] then
                local tChar = plr.Character
                local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                local tHum = tChar and tChar:FindFirstChild("Humanoid")
                if tRoot and tHum and tHum.Health > 0 and (tRoot.Position - root.Position).Magnitude <= KillRadius then
                  local pulse = Instance.new("Part")
                  pulse.Anchored = true
                  pulse.CanCollide = false
                  pulse.Transparency = 0.5
                  pulse.Material = Enum.Material.Neon
                  pulse.Color = Color3.fromRGB(0, 255, 0)
                  pulse.CFrame = tRoot.CFrame
                  pulse.Size = Vector3.new(5, 5, 5)
                  pulse.Parent = workspace
                  TweenService:Create(pulse, TweenInfo.new(0.5), {
                    Size = Vector3.new(0, 0, 0),
                    Transparency = 1
                  }):Play()
                  Debris:AddItem(pulse, 0.5)
                  firetouchinterest(tRoot, leftHand, 0)
                  task.wait()
                  firetouchinterest(tRoot, leftHand, 1)
                  EquipAndPunch()
                end
              end
            end
            task.wait(0.1)
            for _, item in ipairs(fx) do
              item:Destroy()
            end
          end
        end)
        task.wait(0.1)
      end
      ring:Destroy()
    end)
  end
})

