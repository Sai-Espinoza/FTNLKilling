KillingSection:AddToggle({
  Title = "Start Killing",
  Default = false,
  Flag = "Kill_v2_Player",
  Callback = function(state)
    getgenv().killallv2 = state
    if state then
      task.spawn(function()
        while getgenv().killallv2 do
          for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and not Whitelisted[plr.Name] then
              local hum = plr.Character and plr.Character:FindFirstChild("Humanoid")
              if hum and hum.Health > 0 then
                TouchKill(plr)
              end
            end
          end
          RunService.Heartbeat:Wait()
        end
      end)
    end
  end
})

