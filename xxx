local function GetPlayerOptions()
  local list = {}
  for _, plr in ipairs(Players:GetPlayers()) do
    if plr ~= LocalPlayer then
      table.insert(list, plr.Name .. " | " .. plr.DisplayName)
    end
  end
  return list
end

local function SetSpectate(plr)
  if SpectateConn then
    SpectateConn:Disconnect()
    SpectateConn = nil
  end
  local function applyCam()
    if plr and plr.Character and plr.Character:FindFirstChild("Humanoid") then
      workspace.CurrentCamera.CameraSubject = plr.Character.Humanoid
    end
  end
  applyCam()
  if plr then
    SpectateConn = plr.CharacterAdded:Connect(function(char)
      char:WaitForChild("Humanoid")
      applyCam()
    end)
  end
end

local SpectateDropdown
local TargetDropdown

local function RefreshPlayerLists()
  local opts = GetPlayerOptions()
  if SpectateDropdown then
    SpectateDropdown:Set(opts, false)
  end
  if TargetDropdown then
    TargetDropdown:Set(opts, false)
  end
end

SpectateDropdown = SpectateSection:AddDropdown({
  Title = "Select View",
  Options = GetPlayerOptions(),
  Default = "",
  Flag = "SpectateDropdown",
  Callback = function(val)
    local name = string.match(val, "^([^|%s]+)")
    if name then
      SpectateTarget = Players:FindFirstChild(name)
      if SpectateTarget then
        SetSpectate(SpectateTarget)
      end
    end
  end
})

